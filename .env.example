# Environment variables for Protected Community Raise
# Copy to .env and fill in your values

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (used by migrations & seed script)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ─── MiroFish local sidecar (optional) ─────────────────────────────────────
# MiroFish is cloned at ./mirofish/ — a full swarm-intelligence simulation engine.
# To enable real MiroFish predictions:
#   1. cd mirofish && cp .env.example .env   (fill in LLM_API_KEY + ZEP_API_KEY)
#   2. pip install -r mirofish/backend/requirements.txt
#   3. python mirofish/backend/run.py        (starts Flask on port 5001)
#   4. Set MIROFISH_LOCAL_URL below
#
# MiroFish uses any OpenAI-compatible LLM (Qwen, GPT-4, Gemini-via-proxy, etc.)
# and Zep Cloud graph memory (free tier at app.getzep.com).
# Leave MIROFISH_LOCAL_URL blank to always use the Gemini fallback.
MIROFISH_LOCAL_URL=
# (example: MIROFISH_LOCAL_URL=http://localhost:5001)

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Checker ─────────────────────────────────────────────────────────────────
CHECKER_INTERVAL_SECONDS=180
